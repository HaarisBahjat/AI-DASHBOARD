// ——— Utility ———
function useScrollY() {
  const [y, setY] = useState(0);
  useEffect(() => {
    const h = () => setY(window.scrollY);
    window.addEventListener("scroll", h);
    return () => window.removeEventListener("scroll", h);
  }, []);
  return y;
}

// ——— Particle bg ———
function ParticleBg() {
  return (
    <div style={{ position: "fixed", inset: 0, zIndex: 0, pointerEvents: "none", overflow: "hidden" }}>
      {[...Array(18)].map((_, i) => (
        <div key={i} style={{
          position: "absolute",
          width: i % 3 === 0 ? "1px" : "2px",
          height: i % 3 === 0 ? "1px" : "2px",
          borderRadius: "50%",
          background: i % 4 === 0 ? "#b5f542" : "#ffffff22",
          left: `${(i * 17 + 5) % 100}%`,
          top: `${(i * 23 + 10) % 100}%`,
          animation: `floatDot ${6 + (i % 5)}s ease-in-out infinite alternate`,
          animationDelay: `${i * 0.4}s`,
        }} />
      ))}
    </div>
  );
}

